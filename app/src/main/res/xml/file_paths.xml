<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Captures published to Download/<folder>, read back to open them in a
         pcap viewer without ever exposing the whole file system. -->
    <external-path
        name="downloads"
        path="Download/" />
    <!-- Staged captures, used only when publishing failed. -->
    <cache-path
        name="staging"
        path="handshake/" />
</paths>
