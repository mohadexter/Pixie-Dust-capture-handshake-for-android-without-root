    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">A small, single-purpose bench for recovering a WPS PIN with Pixie Dust and validating it once against the access point.</string>
    <string name="about_line_no_internet">No account, no tracking - the network is only used for the optional update check</string>
    <string name="about_line_no_root">No root, no wpa_supplicant</string>
    <string name="about_line_one_attempt">Exactly one PIN attempt per run</string>
    <string name="about_line_logs">PIN and PSK stay in the app\'s private history, never in the logs</string>
    <string name="about_engine">Engine: PixieDust (Python 3.11, bundled with Chaquopy)</string>
    <string name="about_licence">GPL-3.0 — the full licence ships with the source archive.</string>
    <string name="about_close">Close</string>

