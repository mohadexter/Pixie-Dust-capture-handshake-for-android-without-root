<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch"
            android:layout_height="@dimen/touch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/details_title"
            android:textAppearance="@style/TextAppearance.PixieDust.ScreenTitle"
            android:textSize="21sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PixieDust.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ssidText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PixieDust.ScreenTitle"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/bssidText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.PixieDust.Mono"
                        android:textColor="@color/ink_soft" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipChannel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_soft"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.PixieDust.Caption"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/chipBand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_soft"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.PixieDust.Caption"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/chipSecurity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_soft"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.PixieDust.Caption"
                            android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/chipWps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_indigo"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.PixieDust.Caption"
                            android:textColor="@color/indigo" />

                        <TextView
                            android:id="@+id/chipClients"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_soft"
                            android:drawableStart="@drawable/ic_clients"
                            android:drawablePadding="4dp"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="@style/TextAppearance.PixieDust.Caption"
                            android:textColor="@color/ink_soft" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lockout warning -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lockedCard"
                style="@style/Widget.PixieDust.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/amber_soft"
                app:contentPadding="16dp"
                app:strokeColor="@color/amber_soft">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/details_locked_title"
                            android:textAppearance="@style/TextAppearance.PixieDust.Title"
                            android:textColor="@color/amber" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/details_locked_body"
                            android:textAppearance="@style/TextAppearance.PixieDust.Body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Blocked -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/blockedCard"
                style="@style/Widget.PixieDust.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/red_soft"
                app:contentPadding="16dp"
                app:strokeColor="@color/red_soft">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_blocked_title"
                        android:textAppearance="@style/TextAppearance.PixieDust.Title"
                        android:textColor="@color/red" />

                    <TextView
                        android:id="@+id/blockedBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.PixieDust.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plan -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PixieDust.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_section_plan"
                        android:textAppearance="@style/TextAppearance.PixieDust.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/details_step1"
                        android:textAppearance="@style/TextAppearance.PixieDust.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/details_step2"
                        android:textAppearance="@style/TextAppearance.PixieDust.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/details_step3"
                        android:textAppearance="@style/TextAppearance.PixieDust.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/details_step4"
                        android:textAppearance="@style/TextAppearance.PixieDust.Body"
                        android:textColor="@color/indigo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Options -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PixieDust.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_options"
                        android:textAppearance="@style/TextAppearance.PixieDust.Section" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/details_deep"
                                android:textAppearance="@style/TextAppearance.PixieDust.Title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/details_deep_hint"
                                android:textAppearance="@style/TextAppearance.PixieDust.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDeep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/details_verify"
                                android:textAppearance="@style/TextAppearance.PixieDust.Title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/details_verify_hint"
                                android:textAppearance="@style/TextAppearance.PixieDust.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchVerify"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="@string/details_footnote"
                android:textAppearance="@style/TextAppearance.PixieDust.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Widget.PixieDust.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/indigo"
            android:text="@string/details_start"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
