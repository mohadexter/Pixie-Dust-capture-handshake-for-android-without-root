<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="6dp"
    android:paddingEnd="22dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle_green">

        <ImageView
            android:id="@+id/dlgIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_check"
            app:tint="@color/green" />
    </FrameLayout>

    <TextView
        android:id="@+id/dlgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textAppearance="@style/TextAppearance.PixieDust.Title"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/dlgBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.PixieDust.Body" />

    <TextView
        android:id="@+id/dlgValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_mono"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
