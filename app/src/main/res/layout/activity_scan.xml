<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_pad"
        android:paddingTop="18dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_launcher_legacy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_title"
                android:textAppearance="@style/TextAppearance.PixieDust.ScreenTitle"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_count_zero"
                android:textAppearance="@style/TextAppearance.PixieDust.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSupport"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_support"
            android:padding="11dp"
            android:src="@drawable/ic_info"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_history"
            android:padding="11dp"
            android:src="@drawable/ic_history"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Adapter banner -->
    <LinearLayout
        android:id="@+id/adapterBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/screen_pad"
        android:background="@drawable/bg_mono"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/cd_adapter"
            android:src="@drawable/ic_usb" />

        <TextView
            android:id="@+id/adapterText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/scan_adapter_none"
            android:textAppearance="@style/TextAppearance.PixieDust.Caption"
            android:textColor="@color/ink_soft" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PixieDust.Caption" />
    </LinearLayout>

    <!-- List / empty / progress -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:alpha="0.5"
                android:contentDescription="@string/scan_empty_title"
                android:src="@drawable/ic_wifi" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/scan_empty_title"
                android:textAppearance="@style/TextAppearance.PixieDust.Title" />

            <TextView
                android:id="@+id/emptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/scan_empty_body"
                android:textAppearance="@style/TextAppearance.PixieDust.Body" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />
    </FrameLayout>

    <!-- Error card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/errorCard"
        style="@style/Widget.PixieDust.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/red_soft"
        app:strokeColor="@color/red_soft">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/err_title"
                android:textAppearance="@style/TextAppearance.PixieDust.Title"
                android:textColor="@color/red" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.PixieDust.Body" />

            <TextView
                android:id="@+id/errorDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_mono"
                android:padding="10dp"
                android:textAppearance="@style/TextAppearance.PixieDust.Mono"
                android:textSize="11sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.PixieDust.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="@string/btn_retry" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrivers"
            style="@style/Widget.PixieDust.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_drivers"
            app:icon="@drawable/ic_usb"
            app:iconGravity="textStart"
            app:iconTint="@color/indigo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Widget.PixieDust.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:backgroundTint="@color/indigo"
            android:text="@string/scan_btn_scan"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
